{
  "expo": {
    "name": "TapShare",
    "slug": "tapshare",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tapshare.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D0D0E"
      },
      "package": "com.tapshare.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.NFC"
      ]
    },
    "androidStatusBar": {
      "backgroundColor": "#0D0D0E",
      "barStyle": "light-content",
      "translucent": true
    },
    "androidNavigationBar": {
      "backgroundColor": "#0D0D0E",
      "barStyle": "light-content"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow TapShare to access your camera to scan QR codes."
        }
      ],
      "expo-asset",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0D0D0E"
        }
      ],
      "expo-sharing",
      "react-native-nfc-manager"
    ],
    "extra": {
      "eas": {
        "projectId": "6f92a83f-d3fa-4986-be75-b8aca8b0135e"
      }
    },
    "owner": "harrymofoka"
  }
}
