{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "api/card.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/card",
      "dest": "/api/card.js"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
